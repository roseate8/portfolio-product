{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Interactive node-based portfolio website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "snapshot": "node --env-file-if-exists=.env scripts/snapshot-portfolio.mjs",
    "prebuild": "npm run snapshot",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write AGENTS.md docs/**/*.md",
    "format:check": "prettier --check AGENTS.md docs/**/*.md",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:tech-debt": "node scripts/check-tech-debt.mjs",
    "validate": "npm run lint && npm run format:check && npm run check:file-size && npm run check:tech-debt && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nkzw/liquid-glass": "^1.3.0",
    "@react-three/fiber": "^9.5.0",
    "@shadergradient/react": "^2.4.20",
    "@supabase/supabase-js": "^2.89.0",
    "camera-controls": "^3.1.2",
    "d3": "^7.8.5",
    "posthog-js": "^1.333.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "roughjs": "^4.6.6",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.69.5",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
